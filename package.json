{
  "name": "proofline",
  "version": "0.1.0",
  "description": "Local-first delivery-contract CLI: declare acceptance criteria, run only explicitly declared verifiers, record non-secret evidence, and report whether delivery is proven.",
  "private": true,
  "type": "module",
  "module": "src/cli/main.ts",
  "bin": {
    "proofline": "src/cli/main.ts"
  },
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build-release.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
